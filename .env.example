# Local settings; use unique, strong secrets on a production host.
POSTGRES_VOLUME_NAME=oumounakhadija2027_postgres_data
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5435
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=8081
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3002
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5174
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=oumouna_khadija_db
DATABASE_URL=postgresql://postgres:replace-with-a-unique-database-password@postgres:5432/oumouna_khadija_db?schema=public

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-unique-keycloak-database-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-unique-keycloak-admin-password
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_HOSTNAME_PORT=8080
KEYCLOAK_HOSTNAME_STRICT=false
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Exact frontend HTTPS origins, comma-separated, for the backend CORS policy.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://127.0.0.1:5173
