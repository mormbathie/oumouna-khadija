generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTEUR
  COMPTABLE
  ENSEIGNANT
  PARENT
  CONTROLEUR_PRESENCE
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum InvoiceType {
  REGISTRATION
  TUITION
  CANTEEN
  UNIFORM
  TRANSPORT
  OTHER
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  BANK_TRANSFER
  CHECK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum Term {
  TRIMESTRE_1
  TRIMESTRE_2
  TRIMESTRE_3
}

model AccountProfile {
  keycloakId String @id
  user User @relation(fields: [keycloakId], references: [keycloakId], onDelete: Cascade)
  details Json?
  photo Bytes?
  photoMime String?
  updatedAt DateTime @updatedAt
}

model User {
  profile AccountProfile?
  id          String   @id @default(uuid())
  keycloakId  String?  @unique
  email       String   @unique
  username    String?  @unique
  firstName   String
  lastName    String
  role        Role     @default(ENSEIGNANT)
  phone       String?
  mustChangePassword Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classrooms  Classroom[] @relation("TeacherClasses")
  staffAttendances StaffAttendance[]
  staffCard StaffQrCard?
}

model StaffQrCard {
  teacherId String @id
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  token String   @unique
}

model StaffAttendance {
  id          String           @id @default(uuid())
  teacherId   String
  teacher     User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date        DateTime
  status      AttendanceStatus @default(PRESENT)
  checkInAt   DateTime?
  checkOutAt  DateTime?
  minutesLate Int              @default(0)
  checkInById String?
  checkInByName String?
  checkOutById String?
  checkOutByName String?
  reason      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([date, status])
}

model SchoolHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())
}

model SchoolCalendarSettings {
  id          Int      @id @default(1)
  restDays    String   @default("0,6")
  startTime   String   @default("08:00")
  timeZone    String   @default("Africa/Dakar")
  updatedAt   DateTime @updatedAt
}

model AcademicYear {
  id          String      @id @default(uuid())
  name        String      @unique // e.g. "2026-2027"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean     @default(true)
  createdAt   DateTime    @default(now())

  classrooms  Classroom[]
  enrollments Enrollment[]
  invoices    Invoice[]
  grades      Grade[]
  reportCards ReportCard[]
}

model Classroom {
  id              String        @id @default(uuid())
  name            String        // e.g. "CI A", "CP B", "CM2"
  level           String        // "CI", "CP", "CE1", "CE2", "CM1", "CM2"
  capacity        Int           @default(30)
  program         String?
  monthlyTuition  Float         @default(25000)
  registrationFee Float         @default(50000)
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacherId       String?
  teacher         User?         @relation("TeacherClasses", fields: [teacherId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments     Enrollment[]
  grades          Grade[]
  reportCards     ReportCard[]
  attendances     Attendance[]
}

model Parent {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  phone       String
  email       String?
  address     String?
  profession  String?
  relation    String?   @default("Parent") // "Père", "Mère", "Tuteur"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  students    Student[]
  guardianships StudentGuardian[]
  documents   ParentDocument[]
}

model Student {
  departure StudentDeparture?
  id            String        @id @default(uuid())
  duplicateOverrideReason String?
  matricule     String        @unique // e.g. "OS-2026-0001"
  schoolMatricule String?     // Matricule historique attribué par l'école
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  placeOfBirth  String?
  gender        Gender
  address       String?
  transportZone Int?
  supplies        Boolean       @default(false)
  fullDay       Boolean       @default(false)
  karate        Boolean       @default(false)
  eveningClasses Boolean      @default(false)
  emergencyContactName String?
  emergencyContactPhone String?
  healthNotes String?
  schoolItemsProvided String?
  bloodGroup    String?
  photoUrl      String?
  status        StudentStatus @default(ACTIVE)
  parentId      String?
  parent        Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)
  guardians     StudentGuardian[]
  createdById   String?
  createdByName String?
  createdByRole String?
  updatedById   String?
  updatedByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  enrollments   Enrollment[]
  invoices      Invoice[]
  grades        Grade[]
  reportCards   ReportCard[]
  attendances   Attendance[]
  documents     StudentDocument[]

  @@index([schoolMatricule])
}

model StudentGuardian {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relation  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([studentId, parentId])
  @@index([parentId])
}

model Enrollment {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId     String
  classroom       Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  enrollmentDate  DateTime      @default(now())
  status          String        @default("REGISTERED") // REGISTERED, CANCELLED
  remarks         String?
  registeredById   String?
  registeredByName String?
  registeredByRole String?
  createdAt       DateTime      @default(now())

  @@unique([studentId, academicYearId])
}

model Subject {
  id          String   @id @default(uuid())
  name        String   // "Français", "Mathématiques", "Éveil / Science", etc.
  code        String   @unique
  coefficient Float    @default(1.0)
  level       String?  // optionnel si spécifique au niveau
  createdAt   DateTime @default(now())

  grades      Grade[]
}

model Grade {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroomId     String
  classroom       Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term            Term
  score           Float         // Note obtenue (e.g. 16.5)
  maxScore        Float         @default(20.0) // Sur 10 ou sur 20
  coefficient     Float         @default(1.0)
  examType        String        @default("DEVOIR") // "DEVOIR", "COMPOSITION", "INTERRO"
  date            DateTime      @default(now())
  remarks         String?
  createdAt       DateTime      @default(now())
}

model ReportCard {
  id              String        @id @default(uuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId     String
  classroom       Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term            Term
  overallAverage  Float         // Moyenne générale de l'élève (sur 20)
  totalScore      Float?
  totalMaxScore   Float?
  totalCoeff      Float?
  rank            Int?          // Rang dans la classe
  classAverage    Float?        // Moyenne générale de la classe
  minAverage      Float?        // Plus basse moyenne
  maxAverage      Float?        // Plus forte moyenne
  appreciation    String?       // "Très Bien", "Félicitations", etc.
  teacherRemarks  String?
  directorRemarks String?
  generatedAt     DateTime      @default(now())

  @@unique([studentId, classroomId, academicYearId, term])
}

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // e.g. "FAC-2026-0001"
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  title           String        // e.g. "Inscription 2026-2027", "Mensualité Octobre"
  type            InvoiceType   @default(TUITION)
  amount          Float
  paidAmount      Float         @default(0)
  balance         Float
  dueDate         DateTime
  status          InvoiceStatus @default(UNPAID)
  createdById     String?
  createdByName   String?
  createdByRole   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cancelledAt     DateTime?
  cancellationReason String?
  cancelledById   String?
  cancelledByName String?
  cancelledByRole String?
  registrationOptions String?
  category        String?
  billingKey      String?       @unique
  payments        Payment[]
}

model Payment {
  refunds Refund[]
  id            String        @id @default(uuid())
  paymentNumber String        @unique // e.g. "REC-2026-0001"
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod @default(CASH)
  reference     String?       // Numéro transaction Wave / Chèque
  receivedBy    String?       // Nom de l'agent ou comptable
  receivedById  String?
  receivedByRole String?
  cancelledAt     DateTime?
  cancellationReason String?
  cancelledById   String?
  cancelledByName String?
  cancelledByRole String?
  notes         String?
  createdAt     DateTime      @default(now())
}

model Attendance {
  id          String           @id @default(uuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  date        DateTime         @default(now())
  status      AttendanceStatus @default(PRESENT)
  reason      String?
  justified   Boolean          @default(false)
  checkInAt   DateTime?
  checkInById String?
  checkInByName String?
  remarks     String?
  createdAt   DateTime         @default(now())

  @@unique([studentId, classroomId, date])
}


model StudentDocument {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  @@index([studentId, category])
}

model ParentDocument {
  id           String   @id @default(uuid())
  parentId     String
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  category     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  createdAt    DateTime @default(now())

  @@index([parentId, category])
}

model BusinessAudit {
  id String @id @default(uuid())
  action String
  entityId String
  actorId String
  actorName String
  actorRole String
  reason String?
  details String
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}

model CashClosing {
  id String @id @default(uuid())
  day String @unique
  expectedCash Float
  countedCash Float
  difference Float
  summary String
  notes String?
  actorId String
  actorName String
  actorRole String
  createdAt DateTime @default(now())
}

model PaymentReminder {
  id String @id @default(uuid())
  invoiceId String
  billingKey String @unique
  status String @default("SENDING")
  actorId String
  actorName String
  actorRole String
  error String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@index([invoiceId, createdAt])
}

model PaymentInstallment {
  id String @id @default(uuid())
  invoiceId String
  dueDate DateTime
  amount Float
  basePaidAmount Float
  createdAt DateTime @default(now())
  @@index([invoiceId, dueDate])
}

model RegistrationCounter {
  year Int @id
  value Int
}

// Independent configuration; no existing school or financial rows are changed.
model StaffDoorBadge {
  id Int @id @default(1)
  enabled Boolean @default(false)
  token String
  latitude Float?
  longitude Float?
  radiusMeters Int @default(100)
  updatedAt DateTime @updatedAt
}

// Additive ledgers: original invoices and payments remain unchanged.
model StudentDeparture {
  id String @id @default(uuid())
  studentId String @unique
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  departedOn DateTime @db.Date
  reason String
  requestKey String @unique
  actorId String
  actorName String
  actorRole String
  createdAt DateTime @default(now())
}

model Refund {
  id String @id @default(uuid())
  refundNumber String @unique
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount Int
  refundedOn DateTime @db.Date
  paymentMethod PaymentMethod
  reason String
  recipient String
  mode String
  requestKey String @unique
  actorId String
  actorName String
  actorRole String
  createdAt DateTime @default(now())
  @@index([paymentId, createdAt])
  @@index([refundedOn])
}
