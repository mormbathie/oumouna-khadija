[Unit]
Description=Institut Oumouna Khadija encrypted Google Drive backup
After=network-online.target oumouna-khadija-backup.service
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/oumouna-khadija
ExecStart=/bin/bash /opt/oumouna-khadija/deploy/offsite-backup.sh
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=256M
CPUQuota=30%
TimeoutStartSec=1800
