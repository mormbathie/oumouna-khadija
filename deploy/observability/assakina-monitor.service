[Unit]
Description=Institut Oumouna Khadija monitoring email alerts
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/oumouna-khadija
ExecStart=/usr/bin/python3 /opt/oumouna-khadija/deploy/observability/monitor-alerts.py
UMask=0077
Nice=15
MemoryMax=96M
CPUQuota=15%
TimeoutStartSec=150
