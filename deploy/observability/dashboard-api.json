  "spec": {
    "display": {
      "name": "Institut Oumouna Khadija — Requêtes et erreurs API",
      "description": "Statuts HTTP, erreurs et latence. Refresh 60 s ; aucun regroupement par utilisateur ou IP."
    },
    "variables": [],
    "panels": {
      "28594013-6c02-5c53-92b8-baed02ee16ec": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requêtes par statut HTTP",
            "description": "Requêtes API hors healthchecks. Données issues des logs de toutes les requêtes ; pas des traces échantillonnées."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "logs",
                          "source": "",
                          "stepInterval": 60,
                          "aggregations": [
                            {
                              "expression": "count()"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": "service.name = 'as-sakina-backend' AND event = 'http.request' AND route != '/api/health'"
                          },
                          "groupBy": [
                            {
                              "name": "status_code",
                              "fieldContext": "attribute",
                              "fieldDataType": "float64"
                            }
                          ],
                          "order": [],
                          "limit": 20,
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "{{status_code}}"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
